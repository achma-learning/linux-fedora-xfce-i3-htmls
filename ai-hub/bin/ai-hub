#!/usr/bin/env bash
# ai-hub -- open the AI Hub launcher in the default browser, as an app window.
#
# Two things happen here, and both exist for a reason:
#
# 1. A tiny static server on 127.0.0.1. The page loads data/ai.json with
#    fetch(), and browsers refuse fetch() from a file:// page, so opening
#    index.html directly shows an empty grid. Serving it over http also gives
#    the userscript a stable address to send you back to. The server is started
#    only if the port is not already answering, so running this twice is safe.
#
# 2. --app mode. It drops the tab strip and address bar, so the launcher looks
#    and behaves like an application window rather than a browser tab, and i3
#    can then place it on the AI workspace.
#
# Usage: ai-hub [--port N] [--no-browser]

set -euo pipefail

PORT="${AI_HUB_PORT:-8765}"
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
OPEN_BROWSER=1

while [ $# -gt 0 ]; do
  case "$1" in
    --port) PORT="$2"; shift 2 ;;
    --no-browser) OPEN_BROWSER=0; shift ;;
    *) echo "ai-hub: unknown option $1" >&2; exit 2 ;;
  esac
done

URL="http://127.0.0.1:$PORT/"

# --- is something already serving? -------------------------------------------
# bash's /dev/tcp rather than ss/netstat/lsof, none of which are guaranteed to
# be installed.
port_open() { (exec 3<>"/dev/tcp/127.0.0.1/$PORT") 2>/dev/null; }

if ! port_open; then
  command -v python3 >/dev/null || { echo "ai-hub: needs python3 to serve the page" >&2; exit 1; }
  # --bind 127.0.0.1 keeps it off the network; this is a personal launcher, not
  # a web server.
  setsid python3 -m http.server "$PORT" --bind 127.0.0.1 --directory "$ROOT" \
    >/dev/null 2>&1 < /dev/null &
  for _ in $(seq 20); do port_open && break; sleep 0.1; done
  port_open || { echo "ai-hub: server did not come up on $PORT" >&2; exit 1; }
fi

[ "$OPEN_BROWSER" = 1 ] || { echo "$URL"; exit 0; }

# --- default browser, resolved at run time ------------------------------------
desktop=$(xdg-settings get default-web-browser 2>/dev/null || true)
exec_line=""
if [ -n "$desktop" ]; then
  for d in "${XDG_DATA_HOME:-$HOME/.local/share}/applications" \
           /usr/local/share/applications /usr/share/applications; do
    [ -r "$d/$desktop" ] || continue
    exec_line=$(grep -m1 '^Exec=' "$d/$desktop" | cut -d= -f2-)
    break
  done
fi
[ -n "$exec_line" ] || exec_line=$(command -v xdg-open || true)
[ -n "$exec_line" ] || { echo "ai-hub: no default browser found" >&2; exit 1; }

# shellcheck disable=SC2206
cmd=( ${exec_line//%[UuFfic]/} )

case "$(basename "${cmd[0]}")" in
  *firefox*|*librewolf*) exec "${cmd[@]}" --class=AIHub --new-window "$URL" ;;
  *)                     exec "${cmd[@]}" --app="$URL" ;;
esac
