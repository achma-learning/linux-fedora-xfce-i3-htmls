/*
 * macos-adjacent.rasi — rofi theme for this i3 setup.
 *
 * Written against rofi 2.0.0 (`rofi -version`), using rofi-theme(5) and the
 * version-matched examples in /usr/share/rofi/themes/ shipped by rofi-themes.
 * NOT adapted from online rofi 1.7 material.
 *
 * Syntax confirmed against the installed manpages:
 *   - `* { }` variable block, referenced with @name   rofi-theme(5) "Getting started"
 *   - `element selected { }` state selector           rofi-theme(5):756,769
 *   - border-radius                                   rofi-theme(5):891
 *   - location                                        rofi-theme(5):922
 *
 * Colours track ~/.config/i3/config so the launcher matches the window borders.
 */

* {
    /* Same greys as the i3 config's $c-* variables. */
    bg:          #1e1e1eee;   /* slightly translucent: picom composites this */
    bg-entry:    #2a2a2aff;
    bg-selected: #3a3a3aff;
    fg:          #eeeeeeff;
    fg-dim:      #8a8a8aff;
    accent:      #6a9fb5ff;

    background-color: transparent;
    text-color:       @fg;
    font:             "Noto Sans 11";
}

window {
    /* Centred panel rather than a full-width bar — closer to Spotlight. */
    location:         center;
    anchor:           center;
    width:            40%;
    background-color: @bg;
    border-radius:    12px;
    padding:          0px;
    border:           0px;
}

mainbox {
    padding:  8px;
    spacing:  8px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-entry;
    border-radius:    8px;
    padding:          10px 12px;
    spacing:          8px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder:       "Search";
    placeholder-color: @fg-dim;
}

listview {
    lines:        8;
    scrollbar:    false;
    fixed-height: false;   /* shrink the panel when few results match */
    spacing:      2px;
}

element {
    padding:       8px 12px;
    border-radius: 8px;
    spacing:       10px;
    children:      [ element-icon, element-text ];
}

element-icon {
    size:             1.1em;
    vertical-align:   0.5;
}

element-text {
    vertical-align: 0.5;
    text-color:     inherit;
}

/* State selectors — rofi-theme(5) documents `element selected { }`. */
element normal normal   { text-color: @fg; }
element alternate normal { text-color: @fg; }

element selected {
    background-color: @bg-selected;
    text-color:       @fg;
}

element urgent {
    text-color: #c05c5cff;
}
