#!/usr/bin/env bash
# ai-open <url> -- open one URL as an application window in the default browser.
#
# "Application window" matters for two reasons: it drops the tab strip and
# address bar, and — the important one — Chromium-family browsers derive the
# window's WM_CLASS INSTANCE from the URL when (and only when) they are started
# with --app. That instance is the only handle a window manager has for saying
# "chatbot windows belong on the AI workspace": the CLASS is identical for every
# window of the browser.
#
# Without this, a link opened from the hub becomes a tab inside whatever normal
# browser window already exists — on whatever workspace THAT window happens to
# live — and no window rule can move it, because no window was created.

set -euo pipefail
[ $# -eq 1 ] || { echo "usage: ai-open <url>" >&2; exit 2; }
URL="$1"

desktop=$(xdg-settings get default-web-browser 2>/dev/null || true)
exec_line=""
if [ -n "$desktop" ]; then
  for d in "${XDG_DATA_HOME:-$HOME/.local/share}/applications" \
           /usr/local/share/applications /usr/share/applications; do
    [ -r "$d/$desktop" ] || continue
    exec_line=$(grep -m1 '^Exec=' "$d/$desktop" | cut -d= -f2-)
    break
  done
fi
[ -n "$exec_line" ] || exec_line=$(command -v xdg-open || true)
[ -n "$exec_line" ] || { echo "ai-open: no default browser found" >&2; exit 1; }

# shellcheck disable=SC2206
cmd=( ${exec_line//%[UuFfic]/} )

case "$(basename "${cmd[0]}")" in
  # Firefox has no app mode; --class is what it honours instead.
  *firefox*|*librewolf*) exec "${cmd[@]}" --class=AIHub --new-window "$URL" ;;
  *)                     exec "${cmd[@]}" --app="$URL" ;;
esac
